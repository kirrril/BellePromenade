    <ui:VisualElement name="roadSign" style="flex-grow: 1; position: absolute; align-self: center; width: 100%; height: 100%; flex-shrink: 1; flex-direction: column; justify-content: center; align-content: center; top: 0; left: auto;">
        <ui:VisualElement name="rightBoard" class="blackBoard" style="flex-grow: 0; width: 21%; padding-right: 0; padding-left: 0; height: 26%; justify-content: flex-start; top: 12%; flex-shrink: 0; background-color: rgb(0, 0, 0); white-space: normal; right: 5%; position: absolute; padding-top: 0; padding-bottom: 0; left: auto;">
            <ui:Label text="EACH WRONG GUESS COSTS YOU FUEL." name="wrongGuessText" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: 6%; width: 90%; height: 40%; font-size: 32px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); align-self: center; color: rgb(255, 180, 0);" />
            <ui:Label text="EACH RIGHT GUESS TAKES YOU TO A NEW CITY." name="wrongGuessText" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: 51%; width: 90%; height: 45%; font-size: 32px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); align-self: center; position: absolute; color: rgb(255, 180, 0);" />
        </ui:VisualElement>
        <ui:VisualElement name="leftBoard" class="blackBoard" style="flex-grow: 0; width: 21%; align-items: flex-start; justify-content: flex-start; padding-right: 0; padding-left: 0; height: 26%; top: 12%; flex-shrink: 0; background-color: rgb(0, 0, 0); padding-top: 0; padding-bottom: 0; font-size: 40px; color: rgb(255, 156, 0); -unity-font-style: bold; white-space: pre-wrap; left: 5%; transform-origin: left top; background-position-x: left 0; align-self: flex-start; position: absolute;">
            <ui:Label text="ON THE ROAD ACROSS FRANCE!" name="onTheRoadText" style="width: 90%; flex-wrap: nowrap; text-overflow: clip; white-space: normal; font-size: 32px; -unity-text-align: upper-left; height: 50%; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); position: absolute; align-self: center; top: 6%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 180, 0);" />
