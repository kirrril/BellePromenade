<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Vesoul.uss?fileID=7433441132597879392&amp;guid=78101fb1290dfc740978c3aa540a1ffe&amp;type=3#Vesoul" />
    <ui:VisualElement name="authentificationPanel" class="textField" style="flex-grow: 1; justify-content: center; align-content: center; align-items: center; background-color: rgb(16, 77, 125); display: flex; position: absolute; top: 0; right: 0; bottom: 0; left: 0;">
        <ui:Label text="Connection failed.&#10;Check your internet or skip sign-in." name="connectionFailedWarning" class="plainText" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; font-size: 60px; color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        <ui:VisualElement name="authentificationForm" style="flex-grow: 0; position: absolute; width: 1700px; height: 1000px; padding-left: 100px; padding-right: 100px; align-content: center; justify-content: flex-start; background-image: none; flex-shrink: 0; display: flex; background-color: rgb(255, 203, 248); border-top-left-radius: 80px; border-top-right-radius: 80px; border-bottom-right-radius: 80px; border-bottom-left-radius: 80px; border-bottom-width: 7px; border-bottom-color: rgb(120, 50, 150); border-right-color: rgb(120, 50, 150); border-right-width: 7px; border-top-color: rgb(255, 255, 255); border-top-width: 7px; border-left-color: rgb(255, 255, 255); border-left-width: 7px; opacity: 1;">
            <ui:VisualElement name="permisTitle" style="flex-grow: 0; flex-direction: column; align-items: center; flex-shrink: 0; height: 100px; position: absolute; top: 60px; align-self: center; width: 1300px; justify-content: center; align-content: center;">
                <ui:VisualElement name="europeanFlag" style="flex-grow: 1; width: 150px; background-image: url(&quot;project://database/Assets/Sprites/F.png?fileID=-3687348052613884379&amp;guid=4f709721d8ca751469794242ed65a1f0&amp;type=3#F_0&quot;); height: 75px; -unity-background-scale-mode: scale-and-crop; position: absolute; left: 0; align-content: auto;" />
                <ui:Label text="PERMIS DE CONDUIRE" name="permisDeConduireText" class="plainText" style="height: auto; -unity-text-align: middle-right; font-size: 90%; letter-spacing: 2px; -unity-font-style: bold; color: rgb(120, 50, 150); flex-grow: 0; position: absolute; right: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="formContainer" style="flex-grow: 1; position: absolute; top: 210px; align-self: center; width: 1300px; height: 600px;">
                <ui:TabView class="permis plainText">
                    <ui:Tab label="SIGN IN">
                        <ui:VisualElement style="flex-grow: 1; height: 550px; background-color: rgb(255, 255, 255);" />
                        <ui:Label text="Warning" name="signInUsernameWarning" class="plainText" style="height: 105px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 80px; padding-bottom: 0; padding-left: 270px; position: absolute; width: 100%; white-space: normal; -unity-font-style: normal; -unity-text-align: lower-center;" />
                        <ui:VisualElement name="usernameContainer" style="flex-grow: 0; height: 105px; margin-top: 0; margin-bottom: 0; flex-shrink: 0; flex-direction: row; width: 100%; position: absolute; top: 105px; align-items: center;">
                            <ui:Label text="USERNAME" name="usernameLabel" style="position: absolute; left: 50px;" />
                            <ui:TextField name="signInUsernameInput" readonly="false" password="false" class="inputField" style="margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; position: absolute; right: 80px; width: 950px; height: 60px;" />
                        </ui:VisualElement>
                        <ui:Label text="Warning" name="signInPasswordWarning" class="plainText" style="height: 105px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 80px; padding-bottom: 0; padding-left: 270px; position: absolute; top: 210px; width: 100%; -unity-font-style: normal; -unity-text-align: lower-center; white-space: normal;" />
                        <ui:VisualElement name="passwordContainer" style="flex-grow: 0; height: 105px; margin-top: 0; margin-bottom: 0; flex-shrink: 0; flex-direction: row; width: 100%; position: absolute; top: 315px; align-items: center;">
                            <ui:Label text="PASSWORD" name="passwordLabel" style="position: absolute; left: 50px;" />
                            <ui:TextField name="signInPasswordInput" readonly="false" password="true" class="inputField" style="margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; position: absolute; right: 80px; width: 950px; height: 60px;" />
                        </ui:VisualElement>
                        <ui:Button text="SIGN IN" name="signInButton" style="width: 300px; height: 90px; margin-right: 0; margin-left: 0; position: absolute; right: 80px; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; top: 580px; align-content: auto; align-self: flex-end; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; background-color: rgb(120, 50, 150); color: rgb(255, 255, 255); font-size: 40px;" />
                    </ui:Tab>
                    <ui:Tab label="SIGN UP">
                        <ui:VisualElement style="flex-grow: 1; background-color: rgb(255, 255, 255); height: 550px;" />
                        <ui:Label text="Warning" name="signUpUsernameWarning" class="plainText" style="height: 105px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 80px; padding-bottom: 0; padding-left: 270px; position: absolute; width: 100%; white-space: normal; -unity-font-style: normal; -unity-text-align: lower-center;" />
                        <ui:VisualElement name="usernameContainer" style="flex-grow: 0; height: 105px; margin-top: 0; margin-bottom: 0; flex-shrink: 0; flex-direction: row; width: 100%; position: absolute; top: 105px; align-items: center;">
                            <ui:Label text="USERNAME" name="usernameLabel" style="position: absolute; left: 50px;" />
                            <ui:TextField name="signUpUsernameInput" readonly="false" password="false" class="inputField" style="margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; position: absolute; right: 80px; width: 950px; height: 60px;" />
                        </ui:VisualElement>
                        <ui:Label text="Warning" name="signUpPasswordWarning" class="plainText" style="height: 105px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 80px; padding-bottom: 0; padding-left: 270px; position: absolute; top: 210px; width: 100%; -unity-font-style: normal; -unity-text-align: lower-center; white-space: normal;" />
                        <ui:VisualElement name="passwordContainer" style="flex-grow: 0; height: 105px; margin-top: 0; margin-bottom: 0; flex-shrink: 0; flex-direction: row; width: 100%; position: absolute; top: 315px; align-items: center;">
                            <ui:Label text="PASSWORD" name="passwordLabel" style="position: absolute; left: 50px;" />
                            <ui:TextField name="signUpPasswordInput" readonly="false" password="true" class="inputField" style="margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; position: absolute; right: 80px; width: 950px; height: 60px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="confirmPasswordContainer" style="flex-grow: 0; height: 105px; margin-top: 0; margin-bottom: 0; flex-shrink: 0; flex-direction: row; width: 100%; position: absolute; top: 420px; align-items: center;">
                            <ui:TextField name="confirmPasswordInput" readonly="false" password="true" placeholder-text="CONFIRM PASSWORD" class="inputField" style="margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; position: absolute; right: 80px; width: 950px; height: 60px;" />
                        </ui:VisualElement>
                        <ui:Button text="SIGN UP" name="signUpButton" emoji-fallback-support="false" style="width: 300px; height: 90px; margin-right: 0; margin-left: 0; position: absolute; right: 80px; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; top: 580px; align-content: auto; align-self: flex-end; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; background-color: rgb(120, 50, 150); color: rgb(255, 255, 255); font-size: 40px;" />
                    </ui:Tab>
                </ui:TabView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="exitButton" style="position: absolute; top: 50px; right: 50px; width: 80px; height: 80px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/Sprites/CloseForm.png?fileID=239356048812284395&amp;guid=3b226c63b6632d34eb966882c3fda2fb&amp;type=3#CloseForm_0&quot;);" />
    </ui:VisualElement>
    <ui:VisualElement name="authentificationError" style="flex-grow: 1; position: absolute; align-self: center; top: 100px; width: 1400px; height: 900px; background-color: rgb(255, 203, 248); opacity: 1;">
        <ui:Button text="OK" name="okButton" style="position: absolute; top: 650px; align-self: center; width: 400px; height: 150px; background-color: rgb(120, 50, 150); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; color: rgb(255, 255, 255); font-size: 60px; -unity-font-style: bold;" />
        <ui:Label text="Authentification Error Text" name="authErrorText" style="height: 600px; font-size: 60px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; color: rgb(120, 50, 150);" />
    </ui:VisualElement>
    <ui:VisualElement name="loader" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgb(16, 77, 125); opacity: 1;">
        <ui:VisualElement name="wiper" class="loader" style="flex-grow: 1; position: absolute; width: 400px; height: 400px; bottom: 0; top: 450px; align-self: center; background-image: url(&quot;project://database/Assets/Sprites/Loader.png?fileID=2800000&amp;guid=ad7d245e724b51d46bc1e5a26d55aeb3&amp;type=3#Loader&quot;);" />
        <ui:VisualElement name="mask" style="flex-grow: 1; position: absolute; bottom: 0; width: 100%; height: 40%; top: 650px; background-color: rgb(16, 77, 125);" />
    </ui:VisualElement>
</ui:UXML>
