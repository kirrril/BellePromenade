            <ui:TextField placeholder-text="filler text" name="playerInput" style="color: rgb(27, 27, 27); -unity-background-image-tint-color: rgb(255, 255, 255); position: absolute; top: 50px; flex-direction: column; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 80%; display: flex; opacity: 0; overflow: hidden;" />
            <ui:VisualElement name="whiteArrow1" style="flex-grow: 1; bottom: 50px; position: absolute; align-self: center; width: 50px; height: 120px; background-image: url(&quot;project://database/Assets/Sprites/WhiteArrow.png?fileID=21300000&amp;guid=08c769c607db1f744a042a48a54026a0&amp;type=3#WhiteArrow&quot;); left: 200px;" />
            <ui:VisualElement name="whiteArrow2" style="flex-grow: 1; bottom: 50px; position: absolute; align-self: center; width: 50px; height: 120px; background-image: url(&quot;project://database/Assets/Sprites/WhiteArrow.png?fileID=21300000&amp;guid=08c769c607db1f744a042a48a54026a0&amp;type=3#WhiteArrow&quot;);" />
