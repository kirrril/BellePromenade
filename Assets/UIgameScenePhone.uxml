        <ui:VisualElement name="leftBoard" class="blackBoard" style="flex-grow: 0; width: 500px; align-items: flex-start; justify-content: flex-start; padding-right: 30px; padding-left: 30px; height: 400px; top: 10%; flex-shrink: 0; background-color: rgb(0, 0, 0); padding-top: 30px; padding-bottom: 30px; font-size: 40px; color: rgb(255, 156, 0); -unity-font-style: bold; white-space: pre-wrap; left: 5%; transform-origin: left top; background-position-x: left 0; align-self: flex-start; position: absolute;">
