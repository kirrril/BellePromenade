        <ui:VisualElement name="signedIn" style="flex-grow: 1; position: absolute; bottom: 27px; right: auto; width: 75%; height: 75%; background-image: url(&quot;project://database/Assets/Sprites/SignedIn.png?fileID=2800000&amp;guid=f616c5e48dd3bb34fa7e75e753aa01de&amp;type=3#SignedIn&quot;); align-self: center;" />
        <ui:Button name="signInButton" style="position: absolute; right: auto; bottom: 25px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 75%; height: 75%; background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Sprites/SignIn.png?fileID=2800000&amp;guid=f1afaddbbfb244c4b944466dd16781e7&amp;type=3#SignIn&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; opacity: 1; align-self: center;" />
