<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Vesoul.uss?fileID=7433441132597879392&amp;guid=78101fb1290dfc740978c3aa540a1ffe&amp;type=3#Vesoul" />
    <ui:VisualElement name="background" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; flex-shrink: 0; background-image: url(&quot;project://database/Assets/Sprites/Background.png?fileID=-1955448553306655712&amp;guid=1c25f378f69b4e44ba0ca6bcc16cf8a4&amp;type=3#Background_0&quot;); top: 0;">
        <ui:VisualElement name="centralLine1" style="flex-grow: 1; position: absolute; top: 50%; align-self: center; width: 40px; height: 50%; background-image: url(&quot;project://database/Assets/Sprites/CentralLine1.png?fileID=21300000&amp;guid=3aa376840bbab9c4a98513318ddd0aaa&amp;type=3#CentralLine1&quot;); left: 52%; right: 48%;" />
        <ui:VisualElement name="centralLine2" style="flex-grow: 1; position: absolute; top: 50%; align-self: center; width: 40px; height: 50%; background-image: url(&quot;project://database/Assets/Sprites/CentralLine2.png?fileID=21300000&amp;guid=35c6f66e37126124087965940dccb40e&amp;type=3#CentralLine2&quot;); opacity: 0; left: 52%; right: 48%;" />
    </ui:VisualElement>
    <ui:VisualElement name="boards" style="flex-grow: 1; position: absolute; align-self: center; width: 100%; height: 100%; flex-shrink: 1; flex-direction: column; justify-content: center; align-content: center; top: 0; left: auto;">
        <ui:VisualElement name="beam" style="flex-grow: 1; position: absolute; top: 275px; align-items: center; align-self: center; width: 85%; height: 40%; left: auto; right: auto;">
            <ui:VisualElement name="topBeam" style="flex-grow: 1; position: absolute; top: 0; height: 50px; width: 100%; background-color: rgb(120, 120, 120);" />
            <ui:VisualElement name="leftBeam" style="flex-grow: 1; position: absolute; left: 0; height: 100%; width: 50px; background-color: rgb(120, 120, 120);" />
            <ui:VisualElement name="rightBeam" style="flex-grow: 1; position: absolute; left: auto; height: 100%; width: 50px; background-color: rgb(120, 120, 120); right: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="rightBoard" class="blackBoard" style="flex-grow: 0; width: 21%; padding-right: 0; padding-left: 0; height: 26%; justify-content: flex-start; top: 12%; flex-shrink: 0; background-color: rgb(0, 0, 0); white-space: normal; right: 5%; position: absolute; padding-top: 0; padding-bottom: 0; left: auto;">
            <ui:Label text="Comment" name="commentMessage" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: 6%; width: 90%; height: 90%; font-size: 32px; white-space: normal; color: rgb(255, 180, 0); position: absolute; align-self: center;" />
        </ui:VisualElement>
        <ui:VisualElement name="leftBoard" class="blackBoard" style="flex-grow: 0; width: 21%; align-items: center; justify-content: flex-start; padding-right: 0; padding-left: 0; height: 26%; top: 12%; flex-shrink: 0; background-color: rgb(0, 0, 0); padding-top: 0; padding-bottom: 0; font-size: 40px; color: rgb(255, 156, 0); -unity-font-style: bold; white-space: pre-wrap; left: 5%; transform-origin: left top; background-position-x: left 0; align-self: flex-start; position: absolute;">
            <ui:Label text="LETTERS PLAYED&#10;_________________" name="alreadyPlayedLabel" style="width: 90%; flex-wrap: nowrap; text-overflow: clip; white-space: normal; font-size: 29px; -unity-text-align: upper-left; height: 30%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 180, 0); top: 6%; position: absolute;" />
            <ui:Label text="Letters played" name="alreadyPlayedList" style="width: 90%; height: 60%; white-space: normal; top: 40%; font-size: 32px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; color: rgb(255, 180, 0); position: absolute;" />
        </ui:VisualElement>
        <ui:VisualElement name="centralBoard" style="flex-grow: 0; width: 45%; height: 33%; justify-content: flex-start; padding-right: 0; padding-left: 0; top: 12%; background-color: rgb(10, 10, 240); flex-shrink: 0; margin-right: 0; margin-left: 0; background-image: none; position: absolute; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 15px; border-right-width: 15px; border-bottom-width: 15px; border-left-width: 15px; left: auto; align-self: center;">
            <ui:Label text="CARCASSONNE" name="cityName" class="cityToGuess" style="top: 20%; font-size: 70px; width: 90%; align-self: center; height: 30%;" />
            <ui:TextField placeholder-text="filler text" name="playerInput" style="color: rgb(27, 27, 27); -unity-background-image-tint-color: rgb(255, 255, 255); position: absolute; top: 10%; flex-direction: column; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 80%; display: flex; opacity: 0; overflow: hidden;" />
            <ui:VisualElement name="whiteArrow1" style="flex-grow: 1; bottom: 10%; position: absolute; align-self: center; width: 8%; height: 25%; background-image: url(&quot;project://database/Assets/Sprites/WhiteArrow.png?fileID=21300000&amp;guid=08c769c607db1f744a042a48a54026a0&amp;type=3#WhiteArrow&quot;); left: 20%;" />
            <ui:VisualElement name="whiteArrow2" style="flex-grow: 1; bottom: 10%; position: absolute; align-self: center; width: 8%; height: 25%; background-image: url(&quot;project://database/Assets/Sprites/WhiteArrow.png?fileID=21300000&amp;guid=08c769c607db1f744a042a48a54026a0&amp;type=3#WhiteArrow&quot;);" />
            <ui:VisualElement name="whiteArrow3" style="flex-grow: 1; bottom: 10%; position: absolute; align-self: center; width: 8%; height: 25%; background-image: url(&quot;project://database/Assets/Sprites/WhiteArrow.png?fileID=21300000&amp;guid=08c769c607db1f744a042a48a54026a0&amp;type=3#WhiteArrow&quot;); left: auto; right: 20%;" />
            <ui:Button name="inputButton" double-click-selects-word="false" style="position: absolute; width: 100%; height: 100%; align-self: center; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="cockpit" style="flex-grow: 1; position: absolute; bottom: 0; width: 100%; height: 30%; align-content: flex-end;">
        <ui:VisualElement name="dashboard" style="flex-grow: 1; position: absolute; align-self: center; width: 100%; height: 400px; justify-content: flex-end; align-content: flex-end; flex-shrink: 0; bottom: -2px; background-image: none; -unity-background-scale-mode: scale-and-crop; background-position-y: bottom 0; background-position-x: left 0; background-size: contain;">
            <ui:VisualElement name="base" style="flex-grow: 0; position: absolute; left: auto; width: 100%; height: 70%; top: auto; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=-4261196485733639818&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#Dashboard_All_RightBlower&quot;); -unity-background-scale-mode: stretch-to-fill; background-position-x: right 0; background-size: contain; flex-shrink: 0; right: 0; bottom: 0; background-position-y: bottom 0; -unity-slice-scale: 1px;">
                <ui:VisualElement name="bottom" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=-3897340658145114790&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#Dashboard_All_Bottom&quot;);" />
                <ui:VisualElement name="blowerRight" style="flex-grow: 1; position: absolute; bottom: 0; right: 0; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=-4261196485733639818&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#Dashboard_All_RightBlower&quot;); background-position-y: bottom 0; background-position-x: right 0; -unity-background-scale-mode: scale-to-fit; background-size: 100% 100%; height: 100%; width: 180px; align-items: flex-end; align-self: flex-end; flex-direction: column; display: flex;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="steeringUnit" style="flex-grow: 0; position: absolute; height: 100%; width: 65%; left: 0; align-content: flex-end; justify-content: flex-end; align-items: flex-end; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=6524732282985738569&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#Dashboard_All_SteeringUnit&quot;); -unity-background-scale-mode: scale-and-crop; background-position-x: left 0; background-position-y: bottom 0; background-size: contain; flex-shrink: 0; bottom: 0;">
            <ui:VisualElement name="scaleXP" style="flex-grow: 1; position: absolute; align-self: center; align-items: center; align-content: center; justify-content: center; height: 120px; top: auto; width: 330px; left: 22%; bottom: 42%; background-image: url(&quot;project://database/Assets/Sprites/scaleXP.png?fileID=-826314563&amp;guid=8a879022afc3bf04e8ba8ba19a2b0c37&amp;type=3#scaleXP_0&quot;); display: flex; opacity: 0.4;" />
            <ui:VisualElement name="steeringWheel" style="flex-grow: 0; bottom: 0; align-items: center; align-self: center; width: 41%; left: 14%; height: 85%; flex-shrink: 0; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=3867495377750240973&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#Dashboard_All_SteeringWheel&quot;); position: absolute; right: 0%;" />
        </ui:VisualElement>
        <ui:VisualElement name="centralUnit" style="flex-grow: 1; position: absolute; width: 27%; height: 75%; align-self: center; right: auto; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=7198223433854407225&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#Dashboard_All_CentralBlock&quot;); bottom: 0; left: 44%; align-items: center; flex-shrink: 1;">
            <ui:VisualElement name="fuelScale" style="flex-grow: 1; top: 15%; position: absolute; width: 64%; height: 25%; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=-5159082096233897775&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#Dashboard_All_FuelScale&quot;); align-self: center; align-items: center;">
                <ui:VisualElement name="remainingFuel" enabled="true" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/FuelOff.png?fileID=21300000&amp;guid=3637b696a0f21364ebffc64374b53dd1&amp;type=3#FuelOff&quot;); position: absolute; top: 22px; align-self: center; width: 84%; height: 55%; display: flex; left: 9%;" />
            </ui:VisualElement>
            <ui:Button text="&#10;" name="radioPlay" style="bottom: 13%; left: 17%; width: 13%; height: 20%; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=7137042132349984969&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#RadioPlay&quot;); background-size: 40px 50px; position: absolute; top: auto;" />
            <ui:Button text="&#10;" name="radioPause" style="bottom: 13%; left: auto; width: 13%; height: 20%; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=-1588158358035915593&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#RadioPause&quot;); background-size: 44px 50px; position: absolute; right: 14%; top: auto; opacity: 1;" />
            <ui:VisualElement name="radioLCD" style="flex-grow: 1; position: absolute; bottom: 16%; top: auto; width: 31%; height: 14%; background-image: url(&quot;project://database/Assets/Sprites/Dashboard_All.png?fileID=2943220197494712210&amp;guid=5fe34045c0801cb4babdf5e71e2a7ba1&amp;type=3#RadioLCD&quot;); background-size: 100% 100%; opacity: 1; align-self: center;" />
